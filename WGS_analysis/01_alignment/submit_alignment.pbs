#!/bin/bash -l
#PBS -N WGS_BWA_MEM_Alignment
#PBS -l nodes=1:ppn=48
#PBS -l mem=60gb
#PBS -l walltime=72:00:00

# Run from the repository root, or pass REPO_DIR=/path/to/repository with qsub -v.
#
# Required variables (qsub -v):
#   REF           BWA-indexed GRCh38 FASTA
#   R1            read 1 FASTQ
#   R2            read 2 FASTQ
#   SAMPLE        sample identifier (read-group ID and SM)
#   OUT           output sorted BAM
#   TMP_PREFIX    prefix for samtools sort temporary files
# Optional variables (default):
#   BWA_THREADS   threads for BWA-MEM (PBS_NP, else 48)
#   SORT_THREADS  threads for samtools sort (PBS_NP, else 48)

module load BWA/0.7.18-GCCcore-13.2.0
module load SAMtools/1.19.2-GCC-13.2.0

# Strict mode is enabled after the module loads so module scripts are not affected by it.
set -euo pipefail

REPO_DIR="${REPO_DIR:-${PBS_O_WORKDIR:-$PWD}}"
: "${REF:?Set REF}"
: "${R1:?Set R1}"
: "${R2:?Set R2}"
: "${SAMPLE:?Set SAMPLE}"
: "${OUT:?Set OUT}"
: "${TMP_PREFIX:?Set TMP_PREFIX}"
BWA_THREADS="${BWA_THREADS:-${PBS_NP:-48}}"
SORT_THREADS="${SORT_THREADS:-${PBS_NP:-48}}"

bash "$REPO_DIR/WGS_analysis/01_alignment/bwa_mem_alignment.sh" "$REF" "$R1" "$R2" "$SAMPLE" "$OUT" "$TMP_PREFIX" "$BWA_THREADS" "$SORT_THREADS"
