#!/bin/bash -l
#PBS -N WGS_VEP
#PBS -l nodes=1:ppn=16
#PBS -l mem=30gb
#PBS -l walltime=24:00:00

# Run from the repository root, or pass REPO_DIR=/path/to/repository with qsub -v.
#
# Required variables (qsub -v):
#   INPUT_VCF  PASS-only VCF
#   OUT        output annotated VCF (.vcf.gz)
#   STATS      output VEP statistics HTML
#   CACHE_DIR  VEP merged cache directory
#   REF        GRCh38 FASTA
# Optional variables (default):
#   FORKS      number of VEP forks (PBS_NP, else 16)

module load VEP/113.0-GCC-12.3.0

# Strict mode is enabled after the module loads so module scripts are not affected by it.
set -euo pipefail

REPO_DIR="${REPO_DIR:-${PBS_O_WORKDIR:-$PWD}}"
: "${INPUT_VCF:?Set INPUT_VCF}"
: "${OUT:?Set OUT}"
: "${STATS:?Set STATS}"
: "${CACHE_DIR:?Set CACHE_DIR}"
: "${REF:?Set REF}"
FORKS="${FORKS:-${PBS_NP:-16}}"

bash "$REPO_DIR/WGS_analysis/03_variant_calling/annotate_vep.sh" "$INPUT_VCF" "$OUT" "$STATS" "$CACHE_DIR" "$REF" "$FORKS"
