#!/bin/bash -l
#PBS -N WGS_Filter_PASS
#PBS -l nodes=1:ppn=1
#PBS -l mem=10gb
#PBS -l walltime=01:00:00

# Run from the repository root, or pass REPO_DIR=/path/to/repository with qsub -v.
#
# Required variables (qsub -v):
#   REF           GRCh38 FASTA
#   INPUT_VCF     unfiltered Mutect2 VCF
#   FILTERED_VCF  output VCF after FilterMutectCalls
#   PASS_VCF      output VCF with PASS variants only

module load GATK/4.6.0.0-GCCcore-13.2.0-Java-17
module load BCFtools/1.18-GCC-12.3.0

# Strict mode is enabled after the module loads so module scripts are not affected by it.
set -euo pipefail

REPO_DIR="${REPO_DIR:-${PBS_O_WORKDIR:-$PWD}}"
: "${REF:?Set REF}"
: "${INPUT_VCF:?Set INPUT_VCF}"
: "${FILTERED_VCF:?Set FILTERED_VCF}"
: "${PASS_VCF:?Set PASS_VCF}"

bash "$REPO_DIR/WGS/03_variant_calling/filter_mutect2_pass.sh" "$REF" "$INPUT_VCF" "$FILTERED_VCF" "$PASS_VCF"
