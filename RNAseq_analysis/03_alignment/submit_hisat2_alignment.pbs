#!/bin/bash -l
#PBS -N RNA_hisat2_alignment
#PBS -l nodes=1:ppn=48
#PBS -l mem=40gb
#PBS -l walltime=72:00:00

# Run from the repository root, or pass REPO_DIR=/path/to/repository with qsub -v.
#
# Required variables (qsub -v):
#   R1             read 1 FASTQ
#   R2             read 2 FASTQ
#   HISAT2_INDEX   HISAT2 genome index prefix (not a .ht2 file)
#   SPLICE_SITES   HISAT2 known splice sites file
#   OUT_PREFIX     output prefix
#   RG_ID          read-group ID
#   SAMPLE         read-group SM
# Optional variables (default):
#   THREADS        HISAT2 threads (PBS_NP, else 48)
#   LIBRARY        read-group LB (SMARTer_Total_RNA_Mammalian_Pico_Input)
#   PLATFORM_UNIT  read-group PU (NovaSeqX)

module load HISAT2/2.2.1-gompi-2023a

# Strict mode is enabled after the module loads so module scripts are not affected by it.
set -euo pipefail

REPO_DIR="${REPO_DIR:-${PBS_O_WORKDIR:-$PWD}}"
: "${R1:?Set R1}"
: "${R2:?Set R2}"
: "${HISAT2_INDEX:?Set HISAT2_INDEX}"
: "${SPLICE_SITES:?Set SPLICE_SITES}"
: "${OUT_PREFIX:?Set OUT_PREFIX}"
: "${RG_ID:?Set RG_ID}"
: "${SAMPLE:?Set SAMPLE}"
THREADS="${THREADS:-${PBS_NP:-48}}"
LIBRARY="${LIBRARY:-SMARTer_Total_RNA_Mammalian_Pico_Input}"
PLATFORM_UNIT="${PLATFORM_UNIT:-NovaSeqX}"

bash "$REPO_DIR/RNAseq/03_alignment/hisat2_alignment.sh" "$R1" "$R2" "$HISAT2_INDEX" "$SPLICE_SITES" "$OUT_PREFIX" "$THREADS" "$RG_ID" "$SAMPLE" "$LIBRARY" "$PLATFORM_UNIT"
