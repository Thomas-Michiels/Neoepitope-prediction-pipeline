#!/bin/bash -l
#PBS -N RNA_BAM2FASTQ
#PBS -l nodes=1:ppn=4
#PBS -l mem=20gb
#PBS -l walltime=36:00:00

# Run from the repository root, or pass REPO_DIR=/path/to/repository with qsub -v.
#
# Required variables (qsub -v):
#   INPUT_BAM  deduplicated BAM
#   R1_FASTQ   output read 1 FASTQ
#   R2_FASTQ   output read 2 FASTQ
# Optional variables (default):
#   THREADS    samtools threads (PBS_NP, else 4)

module load SAMtools/1.18-GCC-12.3.0

# Strict mode is enabled after the module loads so module scripts are not affected by it.
set -euo pipefail

REPO_DIR="${REPO_DIR:-${PBS_O_WORKDIR:-$PWD}}"
: "${INPUT_BAM:?Set INPUT_BAM}"
: "${R1_FASTQ:?Set R1_FASTQ}"
: "${R2_FASTQ:?Set R2_FASTQ}"
THREADS="${THREADS:-${PBS_NP:-4}}"

bash "$REPO_DIR/RNAseq/04_expression/bam_to_fastq.sh" "$INPUT_BAM" "$R1_FASTQ" "$R2_FASTQ" "$THREADS"
