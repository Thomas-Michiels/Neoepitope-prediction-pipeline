#!/bin/bash -l
#PBS -N HLA_HD
#PBS -l nodes=1:ppn=18
#PBS -l mem=30gb
#PBS -l walltime=48:00:00

# Run from the repository root, or pass REPO_DIR=/path/to/repository with qsub -v.
#
# Required variables (qsub -v):
#   R1          read 1 FASTQ
#   R2          read 2 FASTQ
#   SAMPLE      sample identifier
#   OUT_DIR     output directory
# Optional variables (default):
#   HLAHD_ROOT  HLA-HD installation directory ($VSC_DATA_VO/Shared_Software/hlahd.1.7.0)
#   THREADS     HLA-HD threads (PBS_NP, else 18)

module load Bowtie2/2.5.4-GCC-13.2.0

# Strict mode is enabled after the module loads so module scripts are not affected by it.
set -euo pipefail

REPO_DIR="${REPO_DIR:-${PBS_O_WORKDIR:-$PWD}}"
: "${R1:?Set R1}"
: "${R2:?Set R2}"
: "${SAMPLE:?Set SAMPLE}"
: "${OUT_DIR:?Set OUT_DIR}"
HLAHD_ROOT="${HLAHD_ROOT:-${VSC_DATA_VO:?VSC_DATA_VO must be set}/Shared_Software/hlahd.1.7.0}"
THREADS="${THREADS:-${PBS_NP:-18}}"

bash "$REPO_DIR/WGS/04_HLA_typing/hla_hd.sh" "$R1" "$R2" "$SAMPLE" "$OUT_DIR" "$HLAHD_ROOT" "$THREADS"
