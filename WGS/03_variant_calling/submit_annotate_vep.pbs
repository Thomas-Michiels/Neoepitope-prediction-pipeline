#!/bin/bash -l
#PBS -N WGS_VEP
#PBS -l nodes=1:ppn=16
#PBS -l mem=30gb
#PBS -l walltime=24:00:00

# Paths and parameters used by this job:
# SCRIPT: Path to the corresponding analysis .sh script
# INPUT_VCF: Path to the input VCF file
# OUT: Output file path or output prefix, depending on the analysis script
# STATS: Path for the annotation statistics report
# CACHE_DIR: Path to the local VEP cache directory
# REF: Path to the reference genome FASTA file
# FORKS: Number of VEP parallel forks

module load VEP/113.0-GCC-12.3.0
: "${SCRIPT:?Set SCRIPT}" "${INPUT_VCF:?Set INPUT_VCF}" "${OUT:?Set OUT}" "${STATS:?Set STATS}" "${CACHE_DIR:?Set CACHE_DIR}" "${REF:?Set REF}"
bash "$SCRIPT" "$INPUT_VCF" "$OUT" "$STATS" "$CACHE_DIR" "$REF" "${FORKS:-16}"
