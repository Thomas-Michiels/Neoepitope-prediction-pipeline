#!/bin/bash -l
#PBS -N WGS_Mutect2
#PBS -l nodes=1:ppn=1
#PBS -l mem=60gb
#PBS -l walltime=70:00:00

# Run from the repository root, or pass REPO_DIR=/path/to/repository with qsub -v.
#
# Required variables (qsub -v):
#   REF            GRCh38 FASTA
#   TUMOR_BAM      recalibrated tumor BAM
#   NORMAL_BAM     recalibrated matched-normal BAM
#   NORMAL_SAMPLE  SM read-group tag of the normal BAM
#   OUT            output unfiltered VCF
# Optional variables (default):
#   JAVA_HEAP      Java heap for Mutect2 (56g)

module load GATK/4.6.0.0-GCCcore-13.2.0-Java-17

# Strict mode is enabled after the module loads so module scripts are not affected by it.
set -euo pipefail

REPO_DIR="${REPO_DIR:-${PBS_O_WORKDIR:-$PWD}}"
: "${REF:?Set REF}"
: "${TUMOR_BAM:?Set TUMOR_BAM}"
: "${NORMAL_BAM:?Set NORMAL_BAM}"
: "${NORMAL_SAMPLE:?Set NORMAL_SAMPLE}"
: "${OUT:?Set OUT}"
JAVA_HEAP="${JAVA_HEAP:-56g}"

bash "$REPO_DIR/WGS/03_variant_calling/mutect2.sh" "$REF" "$TUMOR_BAM" "$NORMAL_BAM" "$NORMAL_SAMPLE" "$OUT" "$JAVA_HEAP"
