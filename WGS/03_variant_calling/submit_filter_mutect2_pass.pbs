#!/bin/bash -l
#PBS -N WGS_Filter_PASS
#PBS -l nodes=1:ppn=1
#PBS -l mem=10gb
#PBS -l walltime=01:00:00

module load GATK/4.6.0.0-GCCcore-13.2.0-Java-17
module load BCFtools/1.18-GCC-12.3.0
: "${SCRIPT:?Set SCRIPT}" "${REF:?Set REF}" "${INPUT_VCF:?Set INPUT_VCF}" "${FILTERED_VCF:?Set FILTERED_VCF}" "${PASS_VCF:?Set PASS_VCF}"
bash "$SCRIPT" "$REF" "$INPUT_VCF" "$FILTERED_VCF" "$PASS_VCF"
