#!/bin/bash -l
#PBS -N WGS_BQSR
#PBS -l nodes=1:ppn=1
#PBS -l mem=60gb
#PBS -l walltime=48:00:00

module load SAMtools/1.19.2-GCC-13.2.0
module load GATK/4.6.0.0-GCCcore-13.2.0-Java-17
cd "$PBS_O_WORKDIR"
bash "$SCRIPT" "$INPUT_BAM" "$REF" "$MILLS" "$SNPS" "$DBSNP" "$TABLE" "$OUT" "${JAVA_HEAP:-4g}"
