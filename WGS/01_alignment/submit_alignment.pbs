#!/bin/bash -l

#PBS -N WGS_BWA_MEM_Alignment
#PBS -l nodes=1:ppn=48
#PBS -l mem=60gb
#PBS -l walltime=72:00:00

module load BWA/0.7.18-GCCcore-13.2.0
module load SAMtools/1.19.2-GCC-13.2.0

# Supply REF, R1, R2, SAMPLE, OUT, TMP_PREFIX, and SCRIPT through qsub -v.
# Optional: BWA_THREADS and SORT_THREADS (default: 48 each, as in original notebooks).

bash "$SCRIPT" "$REF" "$R1" "$R2" "$SAMPLE" "$OUT" "$TMP_PREFIX" "${BWA_THREADS:-48}" "${SORT_THREADS:-48}"
