#!/bin/bash -l
#PBS -N RNA_merge_alignments
#PBS -l nodes=1:ppn=16
#PBS -l mem=40gb
#PBS -l walltime=48:00:00

# Paths and parameters used by this job:
# HISAT2_BAM: Path to the HISAT2-aligned BAM file
# BWA_BAM: Path to the BWA-aligned BAM file
# OUTPUT_BAM: Path for the output BAM file
# THREADS: Number of CPU threads to use
# SCRIPT_DIR: Directory containing the corresponding analysis .sh script

module load SAMtools/1.18-GCC-12.3.0
: "${HISAT2_BAM:?Set HISAT2_BAM}"
: "${BWA_BAM:?Set BWA_BAM}"
: "${OUTPUT_BAM:?Set OUTPUT_BAM}"
THREADS=${PBS_NP:-16}
SCRIPT_DIR=${SCRIPT_DIR:?Set SCRIPT_DIR to RNAseq/03_alignment absolute path}
bash "$SCRIPT_DIR/merge_alignments.sh" "$HISAT2_BAM" "$BWA_BAM" "$OUTPUT_BAM" "$THREADS"
