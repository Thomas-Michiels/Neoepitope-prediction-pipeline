#!/bin/bash -l
#PBS -N RNA_bwa_mem_alignment
#PBS -l nodes=1:ppn=48
#PBS -l mem=60gb
#PBS -l walltime=24:00:00

# Run from the repository root, or pass REPO_DIR=/path/to/repository with qsub -v.
#
# Required variables (qsub -v):
#   R1             HISAT2-unmapped read 1 FASTQ
#   R2             HISAT2-unmapped read 2 FASTQ
#   BWA_REFERENCE  BWA-indexed genome FASTA
#   OUTPUT_BAM     output BAM
#   RG_ID          read-group ID
#   SAMPLE         read-group SM
# Optional variables (default):
#   THREADS        BWA threads (PBS_NP, else 48)
#   LIBRARY        read-group LB (SMARTer_Total_RNA_Mammalian_Pico_Input)
#   PLATFORM_UNIT  read-group PU (NovaSeqX)

module load BWA/0.7.17-GCCcore-12.3.0
module load SAMtools/1.18-GCC-12.3.0

# Strict mode is enabled after the module loads so module scripts are not affected by it.
set -euo pipefail

REPO_DIR="${REPO_DIR:-${PBS_O_WORKDIR:-$PWD}}"
: "${R1:?Set R1}"
: "${R2:?Set R2}"
: "${BWA_REFERENCE:?Set BWA_REFERENCE}"
: "${OUTPUT_BAM:?Set OUTPUT_BAM}"
: "${RG_ID:?Set RG_ID}"
: "${SAMPLE:?Set SAMPLE}"
THREADS="${THREADS:-${PBS_NP:-48}}"
LIBRARY="${LIBRARY:-SMARTer_Total_RNA_Mammalian_Pico_Input}"
PLATFORM_UNIT="${PLATFORM_UNIT:-NovaSeqX}"

bash "$REPO_DIR/RNAseq/03_alignment/bwa_mem_alignment.sh" "$R1" "$R2" "$BWA_REFERENCE" "$OUTPUT_BAM" "$THREADS" "$RG_ID" "$SAMPLE" "$LIBRARY" "$PLATFORM_UNIT"
