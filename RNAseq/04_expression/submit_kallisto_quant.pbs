#!/bin/bash -l
#PBS -N RNA_Kallisto
#PBS -l nodes=1:ppn=18
#PBS -l mem=50gb
#PBS -l walltime=24:00:00

# Run from the repository root, or pass REPO_DIR=/path/to/repository with qsub -v.
#
# Required variables (qsub -v):
#   KALLISTO_INDEX  Kallisto transcriptome index
#   R1_FASTQ        read 1 FASTQ
#   R2_FASTQ        read 2 FASTQ
#   OUTPUT_DIR      output directory
# Optional variables (default):
#   THREADS         Kallisto threads (PBS_NP, else 18)

module load kallisto/0.51.1-gompi-2023a

# Strict mode is enabled after the module loads so module scripts are not affected by it.
set -euo pipefail

REPO_DIR="${REPO_DIR:-${PBS_O_WORKDIR:-$PWD}}"
: "${KALLISTO_INDEX:?Set KALLISTO_INDEX}"
: "${R1_FASTQ:?Set R1_FASTQ}"
: "${R2_FASTQ:?Set R2_FASTQ}"
: "${OUTPUT_DIR:?Set OUTPUT_DIR}"
THREADS="${THREADS:-${PBS_NP:-18}}"

bash "$REPO_DIR/RNAseq/04_expression/kallisto_quant.sh" "$KALLISTO_INDEX" "$R1_FASTQ" "$R2_FASTQ" "$OUTPUT_DIR" "$THREADS"
