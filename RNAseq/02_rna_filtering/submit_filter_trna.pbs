#!/bin/bash -l
#PBS -N RNA_filter_trna
#PBS -l nodes=1:ppn=48
#PBS -l mem=80gb
#PBS -l walltime=72:00:00
#PBS -j oe

# Run from the repository root, or pass REPO_DIR=/path/to/repository with qsub -v.
#
# Required variables (qsub -v):
#   R1       read 1 FASTQ
#   R2       read 2 FASTQ
#   OUT      output prefix for reads that pass the filter
# Optional variables (default):
#   INDEX    HISAT2 tRNA index prefix ($VSC_DATA_VO/genomes/Hsapiens/tRNA/hisat2/hsa_tRNA.index)
#   THREADS  HISAT2 threads (PBS_NP, else 48)
#   SAM      SAM output of filtered-out reads (/dev/null)

module load HISAT2/2.2.1-gompi-2023a

# Strict mode is enabled after the module loads so module scripts are not affected by it.
set -euo pipefail

REPO_DIR="${REPO_DIR:-${PBS_O_WORKDIR:-$PWD}}"
: "${R1:?Set R1}"
: "${R2:?Set R2}"
: "${OUT:?Set OUT}"
INDEX="${INDEX:-${VSC_DATA_VO:?VSC_DATA_VO must be set}/genomes/Hsapiens/tRNA/hisat2/hsa_tRNA.index}"
THREADS="${THREADS:-${PBS_NP:-48}}"
SAM="${SAM:-/dev/null}"

bash "$REPO_DIR/RNAseq/02_rna_filtering/filter_ncrna.sh" "$R1" "$R2" "$INDEX" "$OUT" "$THREADS" "$SAM"
