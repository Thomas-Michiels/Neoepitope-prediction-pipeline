#!/bin/bash -l
#PBS -N RNA_filter_snorna
#PBS -l nodes=1:ppn=48
#PBS -l mem=80gb
#PBS -l walltime=72:00:00
#PBS -j oe

# Paths and parameters used by this job:
# R1: Path to the read 1 FASTQ file
# R2: Path to the read 2 FASTQ file
# OUT: Output file path or output prefix, depending on the analysis script
# INDEX: Path to the HISAT2 RNA-filter index prefix
# THREADS: Number of CPU threads to use
# SCRIPT_DIR: Directory containing the corresponding analysis .sh script

module load HISAT2/2.2.1-gompi-2023a
: "${R1:?Set R1}"
: "${R2:?Set R2}"
: "${OUT:?Set OUT (output prefix)}"
INDEX=${INDEX:-$VSC_DATA_VO/genomes/Hsapiens/sn-o-RNA/hisat2/hsa_sn-o-RNA.index}
THREADS=${THREADS:-48}
SAM=${SAM:-/dev/null}
SCRIPT_DIR=${PBS_O_WORKDIR:-$(pwd)}
bash "$SCRIPT_DIR/RNAseq/02_rna_filtering/filter_snorna.sh" "$R1" "$R2" "$INDEX" "$OUT" "$THREADS" "$SAM"
