#!/bin/bash -l
#PBS -N RNA_UMI_read1
#PBS -l nodes=1:ppn=1
#PBS -l mem=20gb
#PBS -l walltime=24:00:00

# Run from the repository root, or pass REPO_DIR=/path/to/repository with qsub -v.
#
# Required variables (qsub -v):
#   R1          read 1 FASTQ
#   R2          read 2 FASTQ
#   OUT_R1      output read 1 FASTQ
#   OUT_R2      output read 2 FASTQ
# Optional variables (default):
#   BC_PATTERN  UMI-tools barcode pattern, read from original Read 1 (NNNNNNNNXXXXXX)

module load UMI-tools/1.1.4-foss-2023a

# Strict mode is enabled after the module loads so module scripts are not affected by it.
set -euo pipefail

REPO_DIR="${REPO_DIR:-${PBS_O_WORKDIR:-$PWD}}"
: "${R1:?Set R1}"
: "${R2:?Set R2}"
: "${OUT_R1:?Set OUT_R1}"
: "${OUT_R2:?Set OUT_R2}"
BC_PATTERN="${BC_PATTERN:-NNNNNNNNXXXXXX}"

bash "$REPO_DIR/RNAseq/01_preprocessing/umi_extraction_read1.sh" "$R1" "$R2" "$OUT_R1" "$OUT_R2" "$BC_PATTERN"
